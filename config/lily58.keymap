#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE            0
#define OS_MAC          1
#define SPECIAL_LEFT    2
#define SPECIAL_RIGHT   3
#define FUNCTION        4

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                     &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DELETE
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T                          &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G                        &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp LGUI  &kp Z  &kp X  &kp C  &kp V  &kp B &mo 4            &tog 1  &kp N  &kp M  &kp LEFT &kp DOWN  &kp UP &kp RIGHT

                &kp LALT  &mo 2  &kp SPACE  &kp LCTRL                    &kp RET  &kp BACKSPACE  &mo 3  &none
            >;
        };

        os_mac {
            display-name = "Mac";

            bindings = <
                &trans &trans &trans &trans &trans &trans                 &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans                 &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans                 &trans &trans &trans &trans &trans &trans
                &kp LALT &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans &trans

                &kp CAPSLOCK &trans &trans &kp LGUI                &trans &trans &trans &kp LCTRL
            >;
        };

        special_left {
            display-name = "Special";

            bindings = <
                &kp EXCL  &kp DQT  &kp HASH  &none  &kp PRCNT  &kp AMPS               &kp FSLH  &kp LPAR  &kp RPAR  &kp EQUAL  &kp PLUS  &kp BSLH
                &kp PIPE  &none  &none  &none  &none  &none                            &none  &none  &none  &none  &none  &kp CARET
                &none  &none  &none  &none  &none  &none                               &none  &none  &none  &none  &none  &kp SQT
                &trans &kp LT  &none  &none  &none  &none  &trans                      &trans  &none  &none &kp COMMA  &kp DOT  &kp MINUS  &none

                &trans  &trans  &trans  &trans                                         &trans  &trans  &trans  &trans
            >;
        };

       special_right {
            display-name = "Special";

            bindings = <
                &none  &kp AT  &none  &kp DLLR  &none  &none               &kp LBRC  &kp LBKT  &kp RBKT  &kp RBRC  &kp QMARK  &kp GRAVE
                &none  &none  &none  &none  &none  &none                   &none  &none  &none  &none  &none  &kp TILDE
                &none  &none  &none  &none  &none  &none                   &none  &none  &none  &none  &none  &kp STAR
                &trans  &kp GT  &none  &none  &none  &none  &trans         &trans  &none  &none  &kp SEMI  &kp COLON  &kp UNDER  &none

                &trans  &trans  &trans  &trans                             &trans  &trans  &trans  &trans
            >;
        };

        function {
            display-name = "Function";

            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                              &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2  &bt BT_SEL 3     &none &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none                            &none  &none  &none  &none  &none  &none
                &trans  &none  &none  &none  &none  &none  &trans                   &trans &none  &none  &none  &none  &none  &none

                &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans
            >;
        };
    };
};
